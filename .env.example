# ── 镜像与服务 ──────────────────────────────────────────────────────────────
# 预构建镜像部署时可固定版本，例如 0.4.0；源码构建会忽略该值。
STRMFLOW_VERSION=latest
HOST=0.0.0.0
PORT=8787

# ── 登录与会话 ──────────────────────────────────────────────────────────────
APP_USER=admin
APP_PASSWORD=change-me
# SESSION_SECRET 由服务首次启动时自动生成并保存到 data/.session_secret。

# ── OpenList ────────────────────────────────────────────────────────────────
# 后端地址使用 Docker 内网服务名；浏览器地址使用局域网或公网地址。
OPENLIST_URL=http://openlist:5244
OPENLIST_WEB_URL=http://192.168.1.10:5244
OPENLIST_TOKEN=your-openlist-admin-token
# OpenList 路径设置了访问密码时填写；没有则留空。
OPENLIST_PATH_PASSWORD=

# ── Emby ────────────────────────────────────────────────────────────────────
EMBY_URL=http://emby:8096
EMBY_WEB_URL=http://192.168.1.10:8096
EMBY_API_KEY=your-emby-api-key

# ── STRM 路径首次启动默认值 ─────────────────────────────────────────────────
# 在 Web 页面保存后，以 SQLite 中的路径配置为准。
LIST_ROOT=/temp_strm
EMBY_STRM_ROOT=/local_media/emby_strm

# ── 数据持久化 ──────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/strmflow.db

# 路径、302 网关、百度网盘追更、媒体探测/截图参数和通知均在 Web 页面配置，
# 配置会持久化到 SQLite，无需继续扩充 .env。

# ── 可选：Cloudflare Turnstile ──────────────────────────────────────────────
# 两项必须同时设置；不使用时保持注释。
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
