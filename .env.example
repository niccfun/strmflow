HOST=0.0.0.0
PORT=8787
DEBUG=false

APP_USER=admin
APP_PASSWORD=change-me
# 生产环境请设置稳定随机值，否则服务重启后现有登录会话失效
SESSION_SECRET=replace-with-a-long-random-value

# 后端 API 地址：Docker 同一网络中使用容器服务名
OPENLIST_URL=http://openlist:5244
# 浏览器外网/局域网访问地址：页面跳转必须使用该地址，不能填写容器服务名
OPENLIST_WEB_URL=http://192.168.1.10:5244
OPENLIST_TOKEN=your-openlist-admin-token
OPENLIST_PATH_PASSWORD=
OPENLIST_TIMEOUT=30
LIST_ROOT=
AUTO_LIST_DEPTH=6
SCAN_LIMIT=2

EMBY_STRM_ROOT=/local_media/emby-strm
# 仅用于首次导入旧版 OpenList JSON；新数据写入 DATABASE_URL
MEDIA_DB_PATH=
# 后端 API 地址：Docker 同一网络中使用容器服务名
EMBY_URL=http://emby:8096
# 浏览器外网/局域网访问地址
EMBY_WEB_URL=http://192.168.1.10:8096
EMBY_API_KEY=your-emby-api-key
EMBY_REFRESH_PATH=/emby/Library/Refresh

# Emby 302 播放网关；启用后会动态监听独立端口
EMBY_302_ENABLED=false
EMBY_302_HOST=0.0.0.0
EMBY_302_PORT=18096
EMBY_302_CACHE_TTL=21600
EMBY_302_CACHE_MAX=1000
EMBY_302_BODY_BUFFER_MAX=1048576
EMBY_302_TIMEOUT_MS=30000

# SQLite 本地持久化数据库；Docker Compose 会将 ./data 挂载到 /app/data
DATABASE_URL=sqlite+aiosqlite:///./data/strmflow.db
# 首次启动且数据库为空时，从旧 OpenList media.json 自动导入一次
LEGACY_JSON_IMPORT=true

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# 百度官方 bdpan CLI；Docker 镜像会通过官方安装器安装，授权配置挂载到 data/bdpan。
BDPAN_ENABLED=false
BDPAN_BINARY=bdpan
# 可选：bdpan config.json 的完整路径或所在目录；默认 ~/.config/bdpan/config.json。
# BDPAN_CONFIG_PATH=/root/.config/bdpan/config.json
BDPAN_TIMEOUT=3600
# 自动追更默认值，可在“系统设置”中覆盖并即时生效。
BDPAN_CHECK_INTERVAL_MINUTES=10
# 相对于 /apps/bdpan/，不要填写 /apps/bdpan/ 之外的目录。
BDPAN_SAVE_ROOT=StrmFlow
BDPAN_SETTLE_SECONDS=90
BDPAN_MAX_NEW_ITEMS=20
TRANSFER_JOB_RETENTION=200
